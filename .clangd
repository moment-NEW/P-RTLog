# .clangd - clangd configuration for P-RTLog
# Docs: https://clangd.llvm.org/config

# ============================================================
# Common flags shared by all files (C and C++)
# ============================================================
CompileFlags:
  Add:
    # ---- Include paths ----
    # Project source root (for "p-macro.h", "tokenizer/...", "log_tokenized/...")
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/src"
    # Project source root (for "P-span.h")
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/src/p-span"
    # Pigweed modules - public headers
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/third_party/pigweed/pw_tokenizer/pw_tokenizer/public"
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/third_party/pigweed/pw_log_tokenized/public"
    # Pigweed modules - override headers (pw_log_backend/...)
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/third_party/pigweed/pw_log_tokenized/public_overrides"
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/third_party/pigweed/pw_log_tokenized/light_public_overrides"
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/third_party/pigweed/pw_log_tokenized/gcc_partially_tokenized_public_overrides"
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/third_party/pigweed/pw_log_tokenized/metadata_public_overrides"
    # Segger RTT
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/third_party/segger_rtt/RTT"
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/third_party/segger_rtt/Config"
    # Stubs for missing pigweed modules (pw_log, pw_polyfill)
    - "-Id:/CODES/Robomaster/Codes_Update/P-RTLog/stubs"

    # ---- Macro definitions ----
    - "-DP_TOKENIZER_CFG_ARG_TYPES_SIZE_BYTES=4"
    - "-DP_TOKENIZER_CFG_C_HASH_LENGTH=128"

    # ---- Suppress noisy warnings from pigweed internals ----
    - "-Wno-unknown-pragmas"
    - "-Wno-unused-function"
    - "-Wno-unused-variable"

  # Remove flags that clangd doesn't understand (GCC-specific)
  Remove:
    - "-mcpu=*"
    - "-mthumb"
    - "-mfloat-abi=*"
    - "-mfpu=*"
    - "-fno-common"
    - "-fdata-sections"
    - "-ffunction-sections"

Diagnostics:
  Suppress:
    - "pp_file_not_found"   # Missing pigweed modules (pw_log, pw_polyfill, etc.)
  UnusedIncludes: None

Index:
  Background: Build

# ============================================================
# C++ files (.cc, .cpp, .hpp) → C++17
# ============================================================
---
If:
  PathMatch: .*\.(cc|cpp|hpp)$
CompileFlags:
  Add:
    - "-std=c++17"
    - "-fno-exceptions"
    - "-fno-rtti"
  Compiler: clang++

# ============================================================
# C files (.c) → C11 (GNU extensions for __attribute__ etc.)
# ============================================================
---
If:
  PathMatch: .*\.c$
CompileFlags:
  Add:
    - "-std=gnu11"
  Compiler: clang

# ============================================================
# C headers (.h) → force C language to avoid ObjC++ ambiguity
# ============================================================
---
If:
  PathMatch: .*\.h$
CompileFlags:
  Add:
    - "-xc"
    - "-std=gnu11"
  Compiler: clang
